[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4

; Libraries live inside the Godot project so they are exported with it.
; Fill client/bin with `tools/copy-gdext.sh [debug|release]` after cargo build.
[libraries]
linux.debug.x86_64 = "res://bin/libopenrail_gdext.so"
linux.release.x86_64 = "res://bin/libopenrail_gdext.so"
windows.debug.x86_64 = "res://bin/openrail_gdext.dll"
windows.release.x86_64 = "res://bin/openrail_gdext.dll"
