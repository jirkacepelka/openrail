# Binary art goes through Git LFS (run `git lfs install` once after cloning)
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
art-src/**/*.png filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
